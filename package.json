{
  "name": "techlab-ecommerce-async-poc",
  "version": "1.0.0",
  "description": "Proof of Concept proving RabbitMQ asynchronous architecture for Techlab E-commerce microservices",
  "main": "services/order-service/index.js",
  "type": "commonjs",
  "scripts": {
    "start:gateway": "node services/api-gateway/index.js",
    "start:order": "node services/order-service/index.js",
    "start:payment": "node services/payment-service/index.js",
    "start:inventory": "node services/inventory-service/index.js",
    "start:notification": "node services/notification-service/index.js",
    "start:analytics": "node services/analytics-service/index.js",
    "test": "node --test tests/*.test.js",
    "test:verbose": "node --test --test-reporter spec tests/*.test.js",
    "benchmark:sync": "node benchmark/load-test.js --mode=sync",
    "benchmark:async": "node benchmark/load-test.js --mode=async",
    "benchmark:all": "node benchmark/load-test.js --mode=both"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "pg": "^8.23.0",
    "uuid": "^10.0.0"
  }
}
